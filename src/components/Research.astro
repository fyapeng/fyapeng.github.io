---
import { publication, workingPapers } from "../data/profile";

const lang = "zh";
const isZh = true;
const pub = publication.zh;
const sep = "、";
---

<h2>{isZh ? "发表论文" : "Publications"}</h2>
<article class="paper" id="mw-2026">
  <h3>{pub.title}</h3>
  <div class="authors">
    {
      pub.authors.map((a, i) => (
        <>
          {i > 0 && sep}
          {"me" in a && a.me ? <b>{a.name}</b> : "url" in a && a.url ? <a href={a.url}>{a.name}</a> : a.name}
          {"corresponding" in a && a.corresponding && "*"}
        </>
      ))
    }
  </div>
  <div class="meta">
    <em>{pub.venue}</em>
    <a href={publication.doi}>DOI</a>
    {isZh && <a href={publication.wechat}>推文</a>}
    <details>
      <summary>{isZh ? "摘要" : "Abstract"}</summary>
      <p>{pub.abstract}</p>
    </details>
    <details>
      <summary>宣讲（{publication.presentations.length}）</summary>
      <div class="presentations">
        <ul>
          {publication.presentations.map((presentation) => <li>{presentation}</li>)}
        </ul>
      </div>
    </details>
  </div>
</article>
<h2>{isZh ? "工作论文" : "Working Papers"}</h2>
{
  workingPapers.map((wp) => (
    <article class="paper" id={wp.id}>
      <h3>{wp.title[lang]}</h3>
      <div class="authors">
        {wp.authors.map((a, i) => (
          <>
            {i > 0 && sep}
            {"me" in a ? <b>{a.name[lang]}</b> : "url" in a ? <a href={a.url}>{a.name[lang]}</a> : a.name[lang]}
            {"corresponding" in a && "*"}
          </>
        ))}
      </div>
      <div class="meta">
        <span>{wp.date[lang]}</span>
        {wp.abstract[lang] && (
          <details>
            <summary>{isZh ? "摘要" : "Abstract"}</summary>
            <p>{wp.abstract[lang]}</p>
          </details>
        )}
        {"presentations" in wp && (
          <details>
            <summary>宣讲（{wp.presentations.length}）</summary>
            <div class="presentations">
              <span>早期版本</span>
              <ul>
                {wp.presentations.map(({ venue, title }) => (
                  <li>
                    {venue}
                    <span class="presentation-title">《{title}》</span>
                  </li>
                ))}
              </ul>
            </div>
          </details>
        )}
      </div>
    </article>
  ))
}

<p class="note">{isZh ? "* 通讯作者" : "* Corresponding author"}</p>

<style>
  .presentations {
    margin-top: 10px;
    padding: 12px 16px;
    background: #f7f7f8;
    border-left: 2px solid var(--accent);
  }
  .presentations ul { margin: 0; padding-inline-start: 1.3em; }
  .presentations > span + ul { margin-top: 4px; }
  .presentations li + li { margin-top: 4px; }
  .presentation-title { display: block; }

  @supports selector(details::details-content) {
    .meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 8px; }
    .meta > * { margin-inline-end: 0; }
    .meta details { display: contents; }
    .meta details::details-content { order: 1; flex: 0 0 100%; min-width: 0; }
    .meta details:not([open])::details-content { display: none; }
  }
</style>
