---
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="zh-CN" data-lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="付亚鹏（Yapeng Fu），经济学博士研究生。研究兴趣包括健康经济学、产业组织与应用微观经济学。" />
    <meta name="author" content="Yapeng Fu / 付亚鹏" />
    <meta name="robots" content="index,follow" />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href="https://fyapeng.com/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Yapeng Fu / 付亚鹏</title>
  </head>

  <body>
    <main class="shell">
      <header class="topbar">
        <a class="domain" href="/" aria-label="fyapeng.com">
          <span class="dot" aria-hidden="true"></span>
          fyapeng.com
        </a>

        <div class="lang-switch" aria-label="Language switcher">
          <button type="button" data-lang-button="zh" aria-pressed="true">中</button>
          <span aria-hidden="true">/</span>
          <button type="button" data-lang-button="en" aria-pressed="false">EN</button>
        </div>
      </header>

      <section class="hero" aria-labelledby="name">
        <div class="content">
          <p class="eyebrow">Economics · UCASS</p>

          <h1 id="name">
            <span class="zh">付亚鹏</span>
            <span class="en">Yapeng Fu</span>
          </h1>

          <p class="alt-name" aria-hidden="true">
            <span class="zh">Yapeng Fu</span>
            <span class="en">付亚鹏</span>
          </p>

          <div class="rule" aria-hidden="true"></div>

          <div class="copy zh">
            <p class="role">中国社会科学院大学 · 经济学博士研究生</p>
            <p class="fields">健康经济学 · 产业组织 · 应用微观经济学</p>
            <a class="contact" href="mailto:yp@fyapeng.com">邮箱</a>
          </div>

          <div class="copy en">
            <p class="role">Ph.D. Student in Economics · UCASS</p>
            <p class="fields">Health Economics · Industrial Organization · Applied Microeconomics</p>
            <a class="contact" href="mailto:yp@fyapeng.com">Email</a>
          </div>
        </div>

        <aside class="marker" aria-hidden="true">
          <span></span>
          <div>ECON<br />BEIJING</div>
        </aside>
      </section>

      <footer>© {year} Yapeng Fu</footer>
    </main>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const buttons = [...document.querySelectorAll('[data-lang-button]')];

        const setLanguage = (value) => {
          const lang = value === 'en' ? 'en' : 'zh';
          root.dataset.lang = lang;
          root.lang = lang === 'en' ? 'en' : 'zh-CN';
          buttons.forEach((button) => {
            button.setAttribute('aria-pressed', String(button.dataset.langButton === lang));
          });
          try { localStorage.setItem('fyapeng-lang', lang); } catch {}
        };

        let initial = 'zh';
        try {
          const saved = localStorage.getItem('fyapeng-lang');
          if (saved === 'zh' || saved === 'en') initial = saved;
          else if (!navigator.language.toLowerCase().startsWith('zh')) initial = 'en';
        } catch {
          if (!navigator.language.toLowerCase().startsWith('zh')) initial = 'en';
        }

        setLanguage(initial);
        buttons.forEach((button) => button.addEventListener('click', () => setLanguage(button.dataset.langButton)));
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --paper: #f4f1ea;
    --ink: #171716;
    --muted: #706d67;
    --line: rgba(23, 23, 22, 0.17);
    --accent: #7c3030;
  }

  * { box-sizing: border-box; }

  html,
  body {
    margin: 0;
    min-height: 100%;
    background: var(--paper);
    color: var(--ink);
  }

  body {
    min-height: 100svh;
    font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  a { color: inherit; }

  .shell {
    width: min(1160px, calc(100% - 64px));
    min-height: 100svh;
    margin: 0 auto;
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 30px 0;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .domain {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--muted);
    text-decoration: none;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
  }

  .lang-switch button {
    appearance: none;
    border: 0;
    padding: 4px 0;
    background: transparent;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    cursor: pointer;
  }

  .lang-switch button[aria-pressed="true"] { color: var(--ink); }

  .hero {
    align-self: center;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 140px;
    align-items: center;
    gap: clamp(48px, 9vw, 120px);
    padding: 8vh 0 12vh;
  }

  .content { max-width: 820px; }

  .eyebrow {
    margin: 0 0 28px;
    color: var(--accent);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-family: "Iowan Old Style", "Palatino Linotype", "Noto Serif SC", "Songti SC", STSong, Georgia, serif;
    font-size: clamp(62px, 10vw, 128px);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.055em;
  }

  html[data-lang="zh"] h1 { letter-spacing: -0.08em; }

  .alt-name {
    margin: 24px 0 0;
    color: var(--muted);
    font-family: "Iowan Old Style", "Palatino Linotype", Georgia, serif;
    font-size: clamp(20px, 2vw, 28px);
    letter-spacing: 0.025em;
  }

  .rule {
    width: min(500px, 76%);
    height: 1px;
    margin: 38px 0 30px;
    background: var(--line);
  }

  .copy { display: grid; gap: 9px; }
  .copy p { margin: 0; }

  .role {
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.7;
  }

  .fields {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.8;
  }

  .contact {
    width: fit-content;
    margin-top: 30px;
    padding-bottom: 5px;
    border-bottom: 1px solid currentColor;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .marker {
    height: 250px;
    display: flex;
    justify-content: flex-end;
    gap: 18px;
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 0.22em;
    writing-mode: vertical-rl;
  }

  .marker > span {
    width: 1px;
    background: var(--line);
  }

  .marker > div {
    display: flex;
    justify-content: space-between;
  }

  footer {
    padding: 22px 0 28px;
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  html[data-lang="zh"] .en,
  html[data-lang="en"] .zh { display: none !important; }

  .domain:focus-visible,
  .contact:focus-visible,
  .lang-switch button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 5px;
  }

  @media (max-width: 720px) {
    .shell { width: min(100% - 40px, 620px); }
    .topbar { padding-top: 22px; }
    .hero { grid-template-columns: 1fr; padding: 10vh 0 14vh; }
    h1 { font-size: clamp(58px, 20vw, 90px); }
    .rule { width: 88%; }
    .marker { display: none; }
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #171716;
      --ink: #f1eee6;
      --muted: #a9a49a;
      --line: rgba(241, 238, 230, 0.18);
      --accent: #c57870;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; }
  }
</style>
